# AgentShield Production Environment
# REQUIRED: All values must be set before deployment

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Security - MUST CHANGE
JWT_ACCESS_SECRET=CHANGE_THIS_TO_RANDOM_32_BYTES_HEX
JWT_REFRESH_SECRET=CHANGE_THIS_TO_RANDOM_32_BYTES_HEX
AGENTSHIELD_API_KEY=CHANGE_THIS_TO_RANDOM_KEY

# PostgreSQL Database - REQUIRED
DB_HOST=postgres.example.com
DB_PORT=5432
DB_NAME=agentshield
DB_USER=agentshield_prod
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_POOL_SIZE=30
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000

# LLM Service
LLM_API_URL=http://llm-api:8000
ENABLE_LLM=true

# Approval Mode
# Options: auto (default), strict (all require approval), audit (all allowed, log all)
APPROVAL_MODE=auto

# Configuration
CONFIG_PATH=/app/agentshield.config.yaml

# Logging
LOG_LEVEL=info

# CORS - Production origins
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Optional: Backup destination
BACKUP_PATH=/backups
BACKUP_RETENTION_DAYS=30

# Optional: Sentry error tracking
SENTRY_DSN=

# Optional: Datadog monitoring
DD_TRACE_ENABLED=false
DD_SERVICE_NAME=agentshield-backend

