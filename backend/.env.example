# AgentShield Environment Configuration

# Server
PORT=3002
HOST=localhost
NODE_ENV=development

# Security
JWT_ACCESS_SECRET=your-secure-access-token-secret-change-in-production
JWT_REFRESH_SECRET=your-secure-refresh-token-secret-change-in-production
AGENTSHIELD_API_KEY=change-me-to-a-strong-random-key
# Production first-run administrator (set both; password must be 12+ characters)
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=change-this-with-a-long-random-password

# Approval Mode
# 'auto'   - auto-approve safe actions, block risky ones
# 'strict' - require human approval for ALL tool calls
# 'audit'  - allow everything but log all calls
APPROVAL_MODE=auto

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentshield
DB_USER=agentshield
DB_PASSWORD=agentshield_password
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000

# LLM Service (for semantic analysis)
LLM_SERVICE_URL=http://127.0.0.1:8000
ENABLE_LLM=true

# Configuration
CONFIG_PATH=./agentshield.config.yaml

# Logging
LOG_LEVEL=info

# CORS - Set allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
